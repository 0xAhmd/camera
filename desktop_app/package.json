{
  "name": "phonecam-desktop",
  "version": "1.0.0",
  "description": "PhoneCam desktop receiver — turns your phone into a webcam",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "ws": "^8.16.0",
    "qrcode": "^1.5.3",
    "bonjour-service": "^1.1.1",
    "node-os-utils": "^1.3.7"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.phonecam.desktop",
    "productName": "PhoneCam",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ]
  }
}
